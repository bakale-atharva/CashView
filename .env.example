# Copy to .env.local and fill in. Never commit real values.

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# The .site domain (HTTP actions), not .cloud. Used by the Clerk webhook endpoint.
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Issuer domain; also set in the Convex dashboard env (read by convex/auth.config.ts)
CLERK_FRONTEND_API_URL=

# Clerk redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Set in the Convex dashboard environment, NOT here or in Vercel ---
# Clerk webhook signing secret (Phase B2/B3)
# CLERK_WEBHOOK_SECRET=
# OpenRouter key for receipt OCR (Phase B9)
# OPENROUTER_API_KEY=
